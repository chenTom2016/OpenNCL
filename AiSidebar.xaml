<UserControl
    x:Class="OpenNCL_Lancher.AiSidebar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="420">

    <Grid Background="#0D0D12">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0F0F18" BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1">
            <Grid Padding="10,0,10,0" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="AI" FontSize="14" FontWeight="SemiBold"
                           Foreground="#E0E0E0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" x:Name="ModelBadge" Text="gpt-4o" FontSize="10"
                           Foreground="#8888AA" VerticalAlignment="Center" />
                <CheckBox Grid.Column="2" x:Name="AgentToggle" IsChecked="True" FontSize="10"
                          Foreground="#666680" Content="Agent" VerticalAlignment="Center"
                          Checked="AgentToggle_Changed" Unchecked="AgentToggle_Changed" />
                <Button Grid.Column="4" x:Name="ClearBtn" Content="Clear" FontSize="10"
                        Foreground="#666680" Background="Transparent" Click="ClearBtn_Click" />
                <Button Grid.Column="5" x:Name="StopBtn" Content="Stop" FontSize="10"
                        Foreground="#FF6B6B" Background="Transparent" Visibility="Collapsed"
                        Click="StopBtn_Click" />
                <Button Grid.Column="6" Content="X" FontSize="10"
                        Foreground="#666680" Background="Transparent" Click="CloseBtn_Click" />
            </Grid>
        </Border>

        <!-- Messages -->
        <ScrollViewer Grid.Row="1" x:Name="MessageScroller" VerticalScrollBarVisibility="Auto"
                      Padding="12,10,12,10">
            <StackPanel x:Name="MessagePanel" Spacing="8" />
        </ScrollViewer>

        <!-- Input -->
        <Border Grid.Row="2" Background="#0F0F18" BorderBrush="#1AFFFFFF" BorderThickness="0,1,0,0"
                Padding="10,10,10,10">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="InputBox"
                         PlaceholderText="Ask anything..."
                         FontFamily="Cascadia Code, Consolas, monospace" FontSize="13"
                         Foreground="#D0D0D8" Background="#14141E"
                         CornerRadius="6" Padding="10,8,10,8"
                         AcceptsReturn="False" KeyDown="InputBox_KeyDown" />
                <Button Grid.Column="1" x:Name="SendBtn" Content="Send"
                        FontSize="12" FontWeight="SemiBold"
                        Foreground="#0D0D12" Background="#00E5A0"
                        CornerRadius="6" Padding="10,8,10,8"
                        Click="SendBtn_Click" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
