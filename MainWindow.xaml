<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="OpenNCL_Lancher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenNCL_Lancher"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="OpenNCL"
    Activated="Window_Activated"
    SizeChanged="Window_SizeChanged">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="#060608" KeyDown="RootGrid_KeyDown" CharacterReceived="RootGrid_CharReceived">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="SidebarColumn" Width="0" />
        </Grid.ColumnDefinitions>

        <!-- Terminal area (Column 0) -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="28" />
                <RowDefinition Height="*" />
                <RowDefinition Height="24" />
            </Grid.RowDefinitions>

            <Canvas x:Name="GradientCanvas" Opacity="0.10" Grid.RowSpan="3" />

            <!-- Top bar -->
            <Border Grid.Row="0" Background="#E60A0A10" BorderBrush="#0AFFFFFF" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="openncl — Terminal" FontSize="10" VerticalAlignment="Center">
                        <TextBlock.Foreground>
                            <SolidColorBrush Color="#FFFFFF" Opacity="0.25" />
                        </TextBlock.Foreground>
                    </TextBlock>
                    <Border BorderBrush="{ThemeResource SystemAccentColorLight3}" BorderThickness="1" CornerRadius="3" Padding="8,1" Margin="12,0,0,0">
                        <TextBlock Text="v4.0" FontSize="9">
                            <TextBlock.Foreground>
                                <SolidColorBrush Color="#00E5A0" Opacity="0.5" />
                            </TextBlock.Foreground>
                        </TextBlock>
                    </Border>
                    <!-- AI sidebar hint -->
                    <TextBlock Text=" Tab=AI" FontSize="9" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock.Foreground>
                            <SolidColorBrush Color="#FFFFFF" Opacity="0.15" />
                        </TextBlock.Foreground>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Terminal area -->
            <ScrollViewer x:Name="OutputScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" PointerPressed="TerminalArea_PointerPressed">
                <RichTextBlock x:Name="TerminalOutput"
                               FontFamily="Cascadia Code, Consolas, monospace"
                               FontSize="13" TextWrapping="Wrap"
                               Padding="22,16,22,50"
                               IsTextSelectionEnabled="True" />
            </ScrollViewer>

            <!-- Bottom bar -->
            <Border Grid.Row="2" Background="#EF0A0A10" BorderBrush="#0AFFFFFF" BorderThickness="0,1,0,0">
                <Grid Padding="14,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="ModeIndicator" Text="normal" FontSize="10" Foreground="#B8B8C0" Margin="0,0,20,0" />
                        <TextBlock x:Name="StatusText" Text="Online" FontSize="10">
                            <TextBlock.Foreground>
                                <SolidColorBrush Color="#FFFFFF" Opacity="0.2" />
                            </TextBlock.Foreground>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock x:Name="CmdCountText" Text="0 commands" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock.Foreground>
                            <SolidColorBrush Color="#FFFFFF" Opacity="0.2" />
                        </TextBlock.Foreground>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>

        <!-- AI Sidebar (Column 1) -->
        <Border Grid.Column="1" BorderBrush="#1AFFFFFF" BorderThickness="1,0,0,0">
            <local:AiSidebar x:Name="AiPanel" />
        </Border>

        <!-- Command Palette (Ctrl+Shift+P) -->
        <Grid x:Name="CommandPaletteOverlay" Grid.ColumnSpan="2"
              Background="#99000000" Visibility="Collapsed"
              Tapped="CommandPaletteOverlay_Tapped">
            <Border Width="560" MaxHeight="420"
                    VerticalAlignment="Top" HorizontalAlignment="Center"
                    Margin="0,80,0,0"
                    Background="#0D0D12" BorderBrush="#2AFFFFFF" BorderThickness="1"
                    CornerRadius="8"
                    Tapped="CommandPalettePanel_Tapped">
                <Grid Margin="10" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="PaletteSearch" Grid.Row="0"
                             PlaceholderText="Search commands…"
                             FontFamily="Cascadia Code, Consolas, monospace"
                             FontSize="13"
                             Background="#14141E" Foreground="#D0D0D8"
                             BorderBrush="#2AFFFFFF"
                             TextChanged="PaletteSearch_TextChanged"
                             KeyDown="PaletteSearch_KeyDown" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ListView x:Name="PaletteList"
                                  SelectionMode="Single"
                                  IsItemClickEnabled="True"
                                  ItemClick="PaletteList_ItemClick"
                                  FontFamily="Cascadia Code, Consolas, monospace" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
